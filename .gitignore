# --- Data zones (architecture.md) ---------------------------------------
# Only data/public/ may ever be tracked, and only at the publish gate with
# per-file license labels validated. Raw/intermediate/curated zones and
# quarantined downloads never enter the repository. Since EP-7 the public
# zone is built and gated locally but ignored too: nothing is published
# before the release gates (quality.md), and a release adds the files
# deliberately (`git add -f data/public/`), never by `git add -A`.
data/raw/
data/intermediate/
data/curated/
data/public/
data/quarantine/
data/cache/
# The stage runner's state file and the fixture pipeline's own data root (EP-4b).
data/pipeline_state.json
data/fixture/
# Routing run records (EP-13): plans, records, RSS series, logs, output tables.
data/runs/

# --- Secrets --------------------------------------------------------------
.env
.env.*
secrets/
*.pem
*.key

# --- Python ---------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
build/
dist/
.python-version.local

# --- Tooling caches -------------------------------------------------------
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
.coverage.*
htmlcov/
.hypothesis/

# --- Notebooks ------------------------------------------------------------
.ipynb_checkpoints/

# --- Local databases ------------------------------------------------------
*.duckdb
*.duckdb.wal
*.db
*.sqlite
*.sqlite3

# --- Logs & scratch -------------------------------------------------------
logs/
*.log
tmp/
scratch/

# --- Project-local runtimes (pinned by manifest, not committed) -----------
# `phillysim toolchain install` (EP-13, ADR-0008) puts the pinned JDK under
# phillysim/.jdk/ and the pinned R5 jar under phillysim/.r5/, and records both
# in phillysim/toolchain.json. Nothing of it is ever tracked.
.jdk/
jdk/
.r5/
*.jar
phillysim/toolchain.json

# --- Node / site build ----------------------------------------------------
node_modules/
site/dist/

# --- OS / editor noise ----------------------------------------------------
Thumbs.db
Desktop.ini
.DS_Store
*.swp
