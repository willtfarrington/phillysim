# --- Data zones (architecture.md) ---------------------------------------
# Only data/public/ may ever be tracked, and only at the publish gate with
# per-file license labels validated. Raw/intermediate/curated zones and
# quarantined downloads never enter the repository.
data/raw/
data/intermediate/
data/curated/
data/quarantine/
data/cache/
# The stage runner's state file and the fixture pipeline's own data root (EP-4b).
data/pipeline_state.json
data/fixture/

# --- Secrets --------------------------------------------------------------
.env
.env.*
secrets/
*.pem
*.key

# --- Python ---------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
build/
dist/
.python-version.local

# --- Tooling caches -------------------------------------------------------
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
.coverage.*
htmlcov/
.hypothesis/

# --- Notebooks ------------------------------------------------------------
.ipynb_checkpoints/

# --- Local databases ------------------------------------------------------
*.duckdb
*.duckdb.wal
*.db
*.sqlite
*.sqlite3

# --- Logs & scratch -------------------------------------------------------
logs/
*.log
tmp/
scratch/

# --- Project-local runtimes (pinned by manifest, not committed) -----------
.jdk/
jdk/
*.jar

# --- Node / site build ----------------------------------------------------
node_modules/
site/dist/

# --- OS / editor noise ----------------------------------------------------
Thumbs.db
Desktop.ini
.DS_Store
*.swp
